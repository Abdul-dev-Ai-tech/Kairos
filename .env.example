# LOCAL DEVELOPMENT ONLY. Replace these values for a real deployment.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-generate-a-long-random-secret-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql://kairos:kairos-local@127.0.0.1:5432/kairos
POSTGRES_DB=kairos
POSTGRES_USER=kairos
POSTGRES_PASSWORD=kairos-local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=KAIROS STORE <orders@localhost>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Absolute persistent media path in production. Omit for local ./media.
# MEDIA_ROOT=/srv/kairos/media
# Enable only behind your own proxy which removes incoming forwarded headers.
TRUST_PROXY_HEADERS=false
# Optional: separate disposable PostgreSQL database for the concurrency tests.
# TEST_DATABASE_URL=postgresql://kairos_test:replace-me@127.0.0.1:5432/kairos_test

# WhatsApp links already use 923157292819. Automatic sends need Meta credentials.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Actual international sender digits, to prevent sending owner alerts to itself.
WHATSAPP_SENDER_NUMBER=
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_CUSTOMER_TEMPLATE=kairos_order_received
WHATSAPP_OWNER_TEMPLATE=kairos_new_order_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
ORDER_NOTIFICATION_DISPATCH=worker
# Optional GPS pin service bounds: min latitude,min longitude,max latitude,max longitude.
LAHORE_SERVICE_BOUNDS=31.20,74.00,31.75,74.65
# Vercel: set DJANGO_SETTINGS_MODULE=config.settings.vercel and the variables below.
# A cloud PostgreSQL DATABASE_URL must include sslmode=require.
# Generate a long random value for the protected notification retry endpoint.
CRON_SECRET=
MEDIA_STORAGE=local
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cloudflare R2 example: https://YOUR-ACCOUNT.r2.cloudflarestorage.com
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# Public image CDN domain only, without https:// (optional).
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=true
